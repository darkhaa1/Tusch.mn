{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "setupFilesAfterEnv": ["<rootDir>/setup-e2e-after-env.ts"],
  "globalSetup": "<rootDir>/setup-e2e-global.ts",
  "maxWorkers": 1,
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@repo/shared(.*)$": "<rootDir>/../../../packages/shared/src$1",
    "^@react-email/render$": "<rootDir>/utils/react-email-render-mock.ts"
  },
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  }
}
