{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "setupFilesAfterEnv": ["<rootDir>/setup-e2e-after-env.ts"],
  "globalSetup": "<rootDir>/setup-e2e-global.ts",
  "maxWorkers": 1,
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@repo/shared(.*)$": "<rootDir>/../../../packages/shared/src$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
