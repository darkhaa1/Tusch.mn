// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  BOTH
}

enum AdminRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  ACTIVE
  HIDDEN
}

enum NotificationType {
  NEW_MESSAGE
  NEW_REVIEW
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_REJECTED
  LISTING_HIDDEN
  ACCOUNT_SUSPENDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum ReportTargetType {
  LISTING
  USER
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  phone       String
  accountType String
  role        UserRole  @default(CLIENT)
  isAdmin     Boolean   @default(false)
  adminRole   AdminRole @default(USER)
  status      UserStatus @default(ACTIVE)
  avatarUrl   String?
  emailVerified    Boolean  @default(false)
  emailVerifyToken String?  @unique
  emailVerifyTokenExp DateTime?
  resetToken     String?   @unique
  resetTokenExp  DateTime?
  onboardingCompletedAt DateTime?
  bio           String?
  city          String?
  serviceCategories String[]
  serviceZones      String[]
  listing     Listing[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsGiven     Review[]  @relation("UserReviewsGiven")
  reviewsReceived  Review[]  @relation("UserReviewsReceived")
  adminActionLogs  AdminActionLog[]
  notifications    Notification[]
  reports          Report[]
  offers           Offer[]        @relation("UserOffers")
  favoriteListings  FavoriteListing[]  @relation("UserFavoriteListings")
  favoriteProviders FavoriteProvider[] @relation("UserFavoriteProviders")
  favoritedBy       FavoriteProvider[] @relation("FavoritedByUsers")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Listing {
  id          String   @id @default(cuid())
  description String
  price       Int
  location    String?
  category    String?
  status      ListingStatus @default(ACTIVE)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  images      ListingImage[]
  message     Message[]
  offers      Offer[]
  favoritedBy FavoriteListing[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  recipientId  String
  listingId    String
  content      String
  readAt       DateTime?
  sender       User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient    User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listing      Listing  @relation(fields: [listingId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  url          String
  thumbnailUrl String?
  position     Int
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime @default(now())

  @@unique([listingId, position])
  @@index([listingId])
}

model Review {
  id           String   @id @default(cuid())
  targetUserId String
  reviewerId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  targetUser User @relation("UserReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewer   User @relation("UserReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([targetUserId])
  @@unique([targetUserId, reviewerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus     @default(PENDING)
  createdAt   DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, targetType, createdAt])
  @@index([reporterId, targetType, targetId, status])
}

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  providerId    String
  price         Int
  message       String
  estimatedDays Int?
  status        OfferStatus @default(PENDING)
  expiresAt     DateTime
  respondedAt   DateTime?
  completedAt  DateTime?
  clientNote   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  provider User    @relation("UserOffers", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([listingId, providerId])
  @@index([providerId])
  @@index([listingId, status])
}

model FavoriteListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFavoriteListings", fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model FavoriteProvider {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserFavoriteProviders", fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  provider   User     @relation("FavoritedByUsers", fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@index([userId])
}
