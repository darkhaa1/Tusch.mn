# App
NODE_ENV=development
PORT=3310

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tusch_db

# Auth / JWT
JWT_SECRET=change-me-in-production-min-16-chars-required
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookie domain (optional — for cross-subdomain cookies in production)
# COOKIE_DOMAIN=.tusch.mn

# Public origin of the web app — used to build links in transactional
# emails. Defaults to http://localhost:3000 when omitted.
# FRONTEND_URL=https://tusch.mn

# Firebase Admin (phone auth). All three are required together to enable
# phone auth. Leave commented to keep the feature disabled.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Resend (transactional email). RESEND_API_KEY + RESEND_FROM_EMAIL must
# be set together to enable outgoing mail. When absent, EmailService is
# disabled and every send() call is a logged no-op — the app boots
# normally. See docs/email.md for the full DNS/Cloudflare setup.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@tusch.mn
# RESEND_FROM_NAME=Tusch
