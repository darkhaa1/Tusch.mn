# API
NEXT_PUBLIC_API_URL=http://localhost:3310

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars

# OAuth Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Facebook (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Firebase (phone auth) — all four required together to enable the feature.
# Leave blank to keep the phone option hidden / disabled gracefully.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# E2E tests (Playwright) — copy to .env.test for local runs
TEST_BASE_URL=http://localhost:3100
TEST_API_URL=http://localhost:3310/api/v1
