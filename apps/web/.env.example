# API
NEXT_PUBLIC_API_URL=http://localhost:3310

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars

# OAuth Google (optional)
GOOGLE_CLIENT_ID=
