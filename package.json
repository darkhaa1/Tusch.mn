{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "echo \"No tests configured\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "smoke": "pnpm -w build && pnpm --filter backend test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "eslint": "9.39.2"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "volta": {
    "node": "24.13.0"
  },
  "pnpm": {
    "overrides": {
      "prisma": "6.19.2",
      "@prisma/client": "6.19.2"
    }
  }
}