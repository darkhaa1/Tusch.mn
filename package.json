{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "pnpm -r typecheck",
    "test": "echo \"No tests configured\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:i18n": "node scripts/check-utf8-and-questionmarks.mjs",
    "smoke": "pnpm -w build && pnpm --filter api test:e2e"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "eslint": "9.39.2",
    "prettier": "^3.8.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "volta": {
    "node": "24.13.0"
  },
  "pnpm": {
    "overrides": {
      "prisma": "6.19.2",
      "@prisma/client": "6.19.2"
    }
  },
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.1.0"
  }
}
