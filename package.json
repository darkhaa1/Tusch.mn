{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "echo \"No tests configured\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "smoke": "pnpm -w build && pnpm --filter backend test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.1.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "eslint": "8.57.1"
    }
  },
  "volta": {
    "node": "24.13.0"
  }
}